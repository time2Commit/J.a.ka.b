# Production settings for docker-compose.yml. Copy to `.env` next to it and fill in the values:
#   cp .env.production.example .env
# (For development use .env.example instead.) Never commit the real .env.

# --- Required ---------------------------------------------------------------------------------

# Password of the PostgreSQL user. It becomes part of a URL: use only letters and digits,
# e.g. the output of `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me

# Signs sessions: at least 32 random characters, e.g. `openssl rand -base64 32`.
AUTH_SECRET=change-me-to-a-long-random-string

# Public address of the site, and of the real-time notes endpoint on the same host.
APP_URL=https://jakab.example.com
COLLAB_PUBLIC_URL=wss://jakab.example.com/collab

# What Caddy serves: a domain name gets a certificate automatically (ports 80 and 443 must
# reach this machine). Use ":80" for plain HTTP, e.g. behind another reverse proxy.
SITE_ADDRESS=jakab.example.com

# --- Optional (defaults shown) ----------------------------------------------------------------

# Time zone of the server (backup schedule, logs). The calendar uses the workspace time zone.
# TZ=Europe/Rome

# Host ports of the reverse proxy.
# HTTP_PORT=80
# HTTPS_PORT=443

# Let people create accounts by themselves after the first (admin) one. Default: only the
# admin creates accounts.
# ALLOW_SIGNUP=false

# Largest file in a note, and largest backup archive the import accepts, in MB.
# UPLOAD_MAX_MB=50
# IMPORT_MAX_MB=4096

# Days a file that no note or version refers to is kept before it is deleted.
# ORPHAN_FILE_DAYS=14

# Nightly backup: cron expression (empty = no schedule), and how many backups of each kind
# (board archive, database dump) to keep. Files go to the `backups` volume.
# BACKUP_CRON=0 3 * * *
# BACKUP_KEEP=7

# Largest WebSocket message the notes server accepts, in MB.
# COLLAB_MAX_PAYLOAD_MB=32
