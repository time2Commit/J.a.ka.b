generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  member
}

enum VersionReason {
  auto
  manual
  pre_restore @map("pre-restore")
}

// ---------------------------------------------------------------------------
// Users and authentication (Better Auth tables + app-specific fields)
// ---------------------------------------------------------------------------

model User {
  id                String   @id
  name              String
  email             String   @unique
  emailVerified     Boolean  @default(false)
  image             String?
  avatarColor       String   @default("#6366f1")
  calendarView      String? // preferred calendar view, see CALENDAR_VIEWS in @jakab/shared
  projectSort       String? // how the project tree is ordered, see PROJECT_SORTS in @jakab/shared
  // Calendars this person chose not to see: a personal choice, kept on the user so it follows them
  // across devices. Calendars themselves are shared by the whole workspace.
  hiddenCalendarIds String[] @default([])
  role              Role     @default(member)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Workspace settings, statuses and labels
// ---------------------------------------------------------------------------

model Workspace {
  id             String   @id @default("default")
  name           String   @default("J.a.ka.b")
  timeZone       String   @default("Europe/Rome")
  workDayStart   String   @default("08:00")
  workDayEnd     String   @default("19:00")
  firstDayOfWeek Int      @default(1) // 0 = Sunday, 1 = Monday
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("workspace")
}

model Status {
  id     String  @id @default(cuid())
  name   String  @unique
  color  String
  order  Int
  isDone Boolean @default(false)

  projects Project[]
  cards    Card[]

  @@map("status")
}

/// A named, colored container of cards, shared by the whole workspace. `kind` is a string checked by
/// zod (not an enum) so a new kind needs no migration; only "local" exists so far. Exactly one
/// calendar is the default (`isDefault`): it receives cards that name no calendar, and it cannot be
/// deleted.
model Calendar {
  id        String  @id @default(cuid())
  name      String  @unique
  color     String
  kind      String  @default("local")
  isDefault Boolean @default(false)
  order     Int

  cards          Card[]
  source         CalendarSource?
  externalEvents ExternalEvent[]

  @@map("calendar")
}

/// A connection to an external provider that feeds one read-only calendar (`Calendar.kind` =
/// "source"). Deleting the calendar deletes the source and its events.
model CalendarSource {
  id                String    @id @default(cuid())
  /// Key of the source definition in the registry (`apps/web/src/server/sources`).
  kind              String
  calendarId        String    @unique
  calendar          Calendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  /// Non-secret options, validated by the definition's zod schema.
  config            Json
  /// Encrypted credentials (see `secret-box.ts`); never sent to the browser, never exported.
  secret            String?
  /// Last characters of the credentials, the only part of them shown after saving.
  secretHint        String?
  enabled           Boolean   @default(true)
  /// Bookkeeping owned by the source: last day fetched, monthly request count...
  state             Json?
  lastSyncAt        DateTime?
  /// Readable reason of the last failed sync; null = the last sync succeeded.
  lastSyncError     String?
  /// Machine-readable reason (key_rejected, quota, ...), so the UI can word it in the user's language.
  lastSyncErrorCode String?
  nextSyncAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([nextSyncAt])
  @@map("calendar_source")
}

/// A cached, read-only event of a source calendar. Never a card: no project, no note.
model ExternalEvent {
  id         String   @id @default(cuid())
  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  /// Stable id from the source, used to update an event instead of duplicating it.
  externalId String
  title      String
  start      DateTime
  end        DateTime
  allDay     Boolean  @default(false)
  url        String?
  /// Small, per-kind, validated by the definition's zod schema; rendered as plain text only.
  details    Json?
  updatedAt  DateTime @updatedAt

  @@unique([calendarId, externalId])
  @@index([calendarId, start, end])
  @@map("external_event")
}

model Label {
  id    String @id @default(cuid())
  name  String @unique
  color String

  projects ProjectLabel[]
  cards    CardLabel[]

  @@map("label")
}

// ---------------------------------------------------------------------------
// Projects, cards and notes
// ---------------------------------------------------------------------------

model Project {
  id             String         @id @default(cuid())
  name           String         @unique
  nameNormalized String         @unique
  statusId       String
  status         Status         @relation(fields: [statusId], references: [id])
  progress       Int            @default(0)
  color          String?
  archivedAt     DateTime?
  folderId       String?
  folder         ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdById    String
  templateId     String?
  template       Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  clonedFromId   String?
  clonedFrom     Project?       @relation("ProjectClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones         Project[]      @relation("ProjectClone")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  labels      ProjectLabel[]
  members     ProjectMember[]
  cards       Card[]
  note        NoteDocument?
  versions    NoteVersion[]
  attachments Attachment[]
  activities  Activity[]

  @@index([statusId])
  @@index([folderId])
  @@map("project")
}

/// A folder of a tree: of projects (`kind` "project") or of templates ("template"). Items without
/// a folder are "uncategorized". A folder and its parent are always of the same kind.
model ProjectFolder {
  id        String          @id @default(cuid())
  kind      String          @default("project")
  name      String
  parentId  String?
  parent    ProjectFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ProjectFolder[] @relation("FolderTree")
  createdAt DateTime        @default(now())

  projects  Project[]
  templates Template[]

  @@index([parentId])
  @@map("project_folder")
}

model ProjectLabel {
  projectId String
  labelId   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([projectId, labelId])
  @@map("project_label")
}

model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_member")
}

model Card {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String?
  start       DateTime
  end         DateTime
  allDay      Boolean  @default(false)
  // Status, progress, labels and members belong to the card. The project keeps the values of the
  // card edited last, as the starting point for its next card.
  statusId    String
  status      Status   @relation(fields: [statusId], references: [id])
  calendarId  String
  calendar    Calendar @relation(fields: [calendarId], references: [id])
  progress    Int      @default(0)
  shortNotes  String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members CardMember[]
  labels  CardLabel[]

  @@index([projectId])
  @@index([statusId])
  @@index([calendarId])
  @@index([start, end])
  @@map("card")
}

model CardMember {
  cardId String
  userId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@map("card_member")
}

model CardLabel {
  cardId  String
  labelId String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@map("card_label")
}

model NoteDocument {
  projectId       String    @id
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  yState          Bytes?
  json            Json?
  updatedAt       DateTime  @updatedAt
  updatedBy       String?
  // Plain text of `json` for searching it, filled in when a search finds it out of date
  // (`searchIndexedAt` differs from `updatedAt`). `searchFolded` is lower case without accents
  // and has a trigram index (see the migration).
  searchText      String?
  searchFolded    String?
  searchIndexedAt DateTime?

  @@map("note_document")
}

model NoteVersion {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  yState    Bytes
  json      Json
  authors   String[]
  reason    VersionReason
  label     String?
  createdBy String?
  createdAt DateTime      @default(now())

  @@index([projectId, createdAt])
  @@map("note_version")
}

model Attachment {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originalName String
  mime         String
  size         Int
  sha256       String
  storageKey   String
  uploadedBy   String
  createdAt    DateTime @default(now())

  @@index([projectId])
  @@map("attachment")
}

model Template {
  id        String         @id @default(cuid())
  name      String         @unique
  defaults  Json
  noteJson  Json?
  folderId  String?
  folder    ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  projects Project[]

  @@index([folderId])
  @@map("template")
}

model Activity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("activity")
}
