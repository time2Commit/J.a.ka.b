# Copy to .env and adjust. Never commit the real .env.

# PostgreSQL connection (matches docker-compose.dev.yml)
DATABASE_URL=postgresql://jakab:jakab@localhost:5432/jakab

# Better Auth: long random string (e.g. `openssl rand -base64 32`)
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the app (used for auth callbacks and links)
APP_URL=http://localhost:3000

# Workspace default time zone (IANA name)
TZ=Europe/Rome

# Maximum upload size in MB (milestone 4)
UPLOAD_MAX_MB=50

# Nightly backup: cron expression in the TZ above (empty = no schedule; "Back up now" in the
# settings still works). Each run writes a board archive (importable) and a pg_dump to BACKUP_DIR,
# and keeps the newest BACKUP_KEEP of each. pg_dump must be installed for the database dump.
BACKUP_CRON=0 3 * * *
BACKUP_DIR=./data/backups
BACKUP_KEEP=7

# Set to true to keep sign-up open after the first (admin) account.
# Default: only the admin creates further accounts.
ALLOW_SIGNUP=false

# Collaboration server (real-time notes)
# Port the collab server listens on
COLLAB_PORT=1234
# WebSocket URL the browser uses to reach it (behind the reverse proxy: wss://your-host/collab)
COLLAB_PUBLIC_URL=ws://localhost:1234
# Address of the web app as seen from the collab server (session validation); defaults to APP_URL
# WEB_INTERNAL_URL=http://localhost:3000
# Address of the collab server's HTTP API as seen from the web app (saving/restoring versions)
# COLLAB_INTERNAL_URL=http://localhost:1234

# Days a file that no note or version refers to is kept before deletion
ORPHAN_FILE_DAYS=14

# Largest backup archive accepted by the import, in MB
IMPORT_MAX_MB=4096

# Where uploaded files are stored (a Docker volume in production)
UPLOAD_DIR=./data/uploads
