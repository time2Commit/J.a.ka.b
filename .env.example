# Copy to .env and adjust. Never commit the real .env.

# PostgreSQL connection (matches docker-compose.dev.yml)
DATABASE_URL=postgresql://jakab:jakab@localhost:5432/jakab

# Better Auth: long random string (e.g. `openssl rand -base64 32`)
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the app (used for auth callbacks and links)
APP_URL=http://localhost:3000

# Workspace default time zone (IANA name)
TZ=Europe/Rome

# Maximum upload size in MB (milestone 4)
UPLOAD_MAX_MB=50

# Cron expression for the optional backup service (milestone 7)
BACKUP_CRON=0 3 * * *

# Set to true to keep sign-up open after the first (admin) account.
# Default: only the admin creates further accounts.
ALLOW_SIGNUP=false

# Collaboration server (real-time notes)
# Port the collab server listens on
COLLAB_PORT=1234
# WebSocket URL the browser uses to reach it (behind the reverse proxy: wss://your-host/collab)
COLLAB_PUBLIC_URL=ws://localhost:1234
# Address of the web app as seen from the collab server (session validation); defaults to APP_URL
# WEB_INTERNAL_URL=http://localhost:3000
